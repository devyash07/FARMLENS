# Production Environment Variables for Frontend
# Copy this file to .env.production for production builds

# Backend API URL - UPDATE THIS WITH YOUR PRODUCTION BACKEND URL
VITE_API_BASE_URL=https://your-backend-domain.com

# App Configuration
VITE_APP_NAME=FarmLens
VITE_APP_VERSION=1.0.0

# Example production values:
# VITE_API_BASE_URL=https://api.farmlens.com
# VITE_API_BASE_URL=https://farmlens-backend.railway.app
# VITE_API_BASE_URL=https://your-app.onrender.com
