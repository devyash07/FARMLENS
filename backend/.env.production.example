# FarmLens Backend Production Environment Variables
# Copy this to your deployment platform's environment variables section
# NEVER commit the actual .env file to git!

# ============================================================================
# REQUIRED: Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ============================================================================
# REQUIRED: AI Service Keys (Choose at least one)
# ============================================================================
# Gemini API (Google AI)
GEMINI_API_KEY=your_gemini_key_here

# Anthropic Claude API (Backup/Alternative)
ANTHROPIC_API_KEY=your_anthropic_key_here

# HuggingFace API (Optional - for model hosting)
HF_TOKEN=your_huggingface_token_here

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=production
DEBUG=false

# CORS Configuration - Set to your actual production domain
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================================================
# Optional: ML Model URL (if hosting models externally)
# ============================================================================
MODEL_URL=https://your-storage-bucket/models/best_farmlens_finetuned.keras

# ============================================================================
# Optional: Monitoring & Logging
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=INFO

# ============================================================================
# SECURITY NOTES:
# ============================================================================
# 1. Generate new keys for production - don't reuse development keys
# 2. Use your deployment platform's secret manager (Render, Railway, Vercel)
# 3. Rotate keys regularly (quarterly recommended)
# 4. Never expose these in client-side code
# 5. Enable IP allowlisting in Supabase for production API
