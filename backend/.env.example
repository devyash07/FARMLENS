# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ============================================
# AI PREDICTION ENGINE
# ============================================
# The system uses a custom-trained EfficientNet model with 66 disease classes
# as the PRIMARY prediction method. No API keys are required for basic operation.
#
# Optional AI Services (for backup/fallback):
# - Anthropic Claude API
# - Google Gemini API (deprecated, not recommended)
# ============================================

# ============================================
# OPTIONAL: AI API Keys (Backup Services)
# ============================================
# Anthropic Claude API (Backup AI - Optional)
# Get it from: https://console.anthropic.com/
# Requires $5 minimum credit
ANTHROPIC_API_KEY=your-anthropic-claude-api-key-here

# Google Gemini API (Optional - Not used by default)
# Get it from: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests/day
# GEMINI_API_KEY=your-google-gemini-api-key-here

# HuggingFace Token (Optional)
# Get it from: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here

# ============================================
# DEPLOYMENT: CORS Configuration
# ============================================
# Comma-separated list of allowed frontend origins
# Development: http://localhost:8080,http://localhost:5173
# Production: https://your-frontend-domain.com,https://www.your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8081,http://localhost:3000

# ============================================
# DEPLOYMENT: Environment
# ============================================
# Set to 'production' or 'development'
ENVIRONMENT=development

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================
# Server port (default: 8001)
PORT=8001

# Enable debug logging (true/false)
DEBUG=false

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Update SUPABASE credentials with your project details
# 3. Update ALLOWED_ORIGINS with your production frontend URL
# 4. (Optional) Add API keys for backup AI services
# 5. Never commit the .env file to version control
#
# Get API Keys (if needed):
# - Supabase: https://supabase.com/dashboard/project/_/settings/api
# - Claude (optional): https://console.anthropic.com/
# - Gemini (optional): https://makersuite.google.com/app/apikey
# - HuggingFace (optional): https://huggingface.co/settings/tokens
#
# NOTE: The custom ML model (farmlens_efficientnet.keras) is the PRIMARY
# prediction method and works without any API keys!
